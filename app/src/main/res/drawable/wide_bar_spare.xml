<?xml version="1.0" encoding="utf-8"?>
<!-- 한 줄 위젯 막대(여유일 때): 사용 = 초록, 여유 = 연한 초록 채움 + 초록 테두리.
     채움과 테두리 색이 달라 틴트 없이 여기서 색을 지정. scale을 써서 채워진 끝도 둥글게 유지 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="5dp" />
            <solid android:color="@color/claude_track" />
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress">
        <scale
            android:scaleGravity="left|center_vertical"
            android:scaleWidth="100%">
            <shape>
                <corners android:radius="5dp" />
                <solid android:color="@color/claude_spare" />
                <stroke
                    android:width="2dp"
                    android:color="@color/claude_ok" />
            </shape>
        </scale>
    </item>
    <item android:id="@android:id/progress">
        <scale
            android:scaleGravity="left|center_vertical"
            android:scaleWidth="100%">
            <shape>
                <corners android:radius="5dp" />
                <solid android:color="@color/claude_ok" />
            </shape>
        </scale>
    </item>
</layer-list>
