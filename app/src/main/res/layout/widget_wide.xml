<?xml version="1.0" encoding="utf-8"?>
<!-- 한 줄(5x1) 위젯: 왼쪽 주간 사용량(누르면 바로 입력) · 가운데 권장 누적·여유/초과·주간 초기화까지 + 주간 막대
     + 5시간 막대·남은 시간 · 오른쪽 새로고침 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingEnd="6dp">

    <LinearLayout
        android:id="@+id/w_used_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/w_used_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:letterSpacing="-0.02"
                android:maxLines="1"
                android:text="--"
                android:textColor="@color/claude_fg"
                android:textFontWeight="800"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/w_used_pct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="1dp"
                android:includeFontPadding="false"
                android:text="%"
                android:textColor="@color/claude_fg"
                android:textFontWeight="700"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/w_used_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:text="사용량 입력"
            android:textColor="@color/claude_sub"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/w_top_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/w_dot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="5dp"
                android:importantForAccessibility="no"
                android:src="@drawable/dot_ok" />

            <TextView
                android:id="@+id/w_top_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="권장 "
                android:textColor="@color/claude_sub"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/w_top_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:textColor="@color/claude_fg"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:textColor="@color/claude_ok_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- 주간 초기화까지 남은 시간: 남는 자리를 채워 오른쪽 끝에(좁으면 이것부터 줄어듦) -->
            <TextView
                android:id="@+id/w_reset_in"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFeatureSettings="tnum"
                android:gravity="end"
                android:maxLines="1"
                android:textColor="@color/claude_sub"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/w_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="탭해서 초기화 시각을 설정하세요"
            android:textColor="@color/claude_fg"
            android:textFontWeight="500"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/w_bar"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="6dp"
            android:max="1000"
            android:maxHeight="10dp"
            android:minHeight="10dp"
            android:progressDrawable="@drawable/wide_bar" />

        <!-- 5시간(현재 세션): 라벨 · 얇은 막대 · 값 · 남은 시간 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:maxLines="1"
                android:text="5시간"
                android:textColor="@color/claude_sub"
                android:textSize="11sp" />

            <ProgressBar
                android:id="@+id/w_session_bar"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_weight="1"
                android:max="1000"
                android:maxHeight="4dp"
                android:minHeight="4dp"
                android:progressDrawable="@drawable/session_bar" />

            <TextView
                android:id="@+id/w_session_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:text="--"
                android:textColor="@color/claude_sub"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_session_rest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:textColor="@color/claude_sub"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_refresh"
        android:layout_width="34dp"
        android:layout_height="52dp"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:contentDescription="새로고침"
            android:src="@drawable/ic_refresh" />

        <TextView
            android:id="@+id/w_refresh_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFeatureSettings="tnum"
            android:text="--:--"
            android:textColor="@color/claude_sub"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
